# Copy to .env; choose a model available to your provider/account.
# Examples of model syntax are provider/model-name. No key is included.
MODEL=
OPENAI_API_KEY=
# Optional live search: install .[web], set true, and supply your Serper key.
ENABLE_WEB_SEARCH=false
SERPER_API_KEY=
# Relative paths resolve from the project root when running there.
PUBLISHING_DATA_DIR=data
PUBLISHING_OUTPUT_DIR=output
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
